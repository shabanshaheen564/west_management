APP_NAME="Smart Waste Management"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=waste_management
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@waste-management.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb WebSocket
REVERB_APP_ID=waste-management
REVERB_APP_KEY=your-reverb-key
REVERB_APP_SECRET=your-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080

# OpenRouteService API
ORS_API_KEY=your-openrouteservice-api-key
ORS_BASE_URL=https://api.openrouteservice.org

# Default Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# GIS Settings
DEFAULT_LAT=31.9038
DEFAULT_LNG=35.2034
DEFAULT_ZOOM=13
